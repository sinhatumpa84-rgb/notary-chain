# =============================================================
# NotaryChain Environment Configuration
# =============================================================

# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/notarychain

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production
JWT_REFRESH_EXPIRE=7d

# Encryption (AES-256)
ENCRYPTION_KEY=your-32-character-encryption-key!

# Email (Nodemailer SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=NotaryChain <noreply@notarychain.com>

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_PATH=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# AI Service (Placeholder - configure when connecting real services)
AI_SERVICE_URL=http://localhost:8000/api/ai
AI_API_KEY=your-ai-service-api-key

# Logging
LOG_LEVEL=debug

# Stellar / Freighter Testnet Wallet
FREIGHTER_TESTNET_WALLET=GBT73LMEDNGASAHFDULIEINFWZVLWTPJVK6Q3OEGGW6G54AHENA3JLDA
VITE_FREIGHTER_TESTNET_WALLET=GBT73LMEDNGASAHFDULIEINFWZVLWTPJVK6Q3OEGGW6G54AHENA3JLDA

# =============================================================
# Google OAuth / Firebase Authentication
# =============================================================
# 1. Go to https://console.firebase.google.com → select your project
# 2. Enable Authentication → Sign-in method → Google
# 3. Copy values below from Project Settings → General → Your apps

# Backend (server/.env)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Frontend (client/.env  or root .env with VITE_ prefix)
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# =============================================================
# Polygon Amoy Blockchain (Testnet)
# =============================================================
# RPC endpoint (free public node)
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Private key of the wallet that will sign transactions (0x prefix)
BLOCKCHAIN_PRIVATE_KEY=0x...

# Deployed NotaryChain contract address on Polygon Amoy
CONTRACT_ADDRESS=0x...
# Get testnet MATIC at: https://faucet.polygon.technology


