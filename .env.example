# ==============================================================================
# NotaryChain Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# IMPORTANT SECURITY NOTICE:
# - NEVER commit your real .env file or any credentials to version control.
# - Replace all placeholders below with your actual credentials in .env.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# MongoDB connection URI (e.g. local instance or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/notarychain

# ------------------------------------------------------------------------------
# 3. Authentication & Security Configuration
# ------------------------------------------------------------------------------
# JWT secrets used for signing access tokens and refresh tokens
JWT_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# AES-256 Symmetric Encryption Key (32 alphanumeric characters)
ENCRYPTION_KEY=your_32_character_aes_encryption_key_here

# Rate limiting and file upload policies
MAX_FILE_SIZE=52428800
UPLOAD_PATH=./uploads
RATE_LIMIT=100
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# ------------------------------------------------------------------------------
# 4. AI & Inference Engine Configuration
# ------------------------------------------------------------------------------
# Google Gemini API configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Google Gamma / Gemma API configuration
GAMMA_API_KEY=your_gamma_api_key_here
GEMMA_API_KEY=your_gemma_api_key_here

# xAI Grok API configuration
XAI_API_KEY=your_xai_api_key_here
GROK_API_KEY=your_grok_api_key_here

# Groq Open-Source Inference API configuration
GROQ_API_KEY=your_groq_api_key_here

# HuggingFace Inference API configuration (Zero-shot classification)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_SECURITY_MODEL=facebook/bart-large-mnli

# DigitalOcean GenAI Inference (Optional cloud reasoning layer)
DIGITALOCEAN_INFERENCE_URL=your_digitalocean_inference_url_here
DIGITALOCEAN_INFERENCE_KEY=your_digitalocean_inference_key_here

# AI Routing Engine Toggle & Face Recognition Service URL
AI_ENABLED=true
AI_SERVICE_URL=http://localhost:5001

# ------------------------------------------------------------------------------
# 5. Blockchain & Web3 Configuration (Polygon Amoy Testnet & Stellar)
# ------------------------------------------------------------------------------
# Polygon Amoy RPC endpoint
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Private key of the wallet signing blockchain notary anchors (hex without/with 0x)
BLOCKCHAIN_PRIVATE_KEY=your_polygon_wallet_private_key_here

# Deployed NotaryChain smart contract address
CONTRACT_ADDRESS=your_deployed_contract_address_here

# Polygon Order Management System (OMS) API configuration
POLYGON_OMS_BASE_URL=https://sandbox-api.polygon.technology/v0.11
POLYGON_OMS_API_KEY=your_polygon_oms_api_key_here
POLYGON_OMS_API_SECRET=your_polygon_oms_api_secret_here

# Stellar / Freighter Testnet Wallet
FREIGHTER_TESTNET_WALLET=your_freighter_testnet_wallet_address_here

# ------------------------------------------------------------------------------
# 6. Payment Gateway Configuration (Razorpay)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ------------------------------------------------------------------------------
# 7. Google OAuth & Firebase Authentication
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your_firebase_project_id_here
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 8. Email / SMTP Notification Service
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username_or_email_here
SMTP_PASS=your_smtp_password_here
EMAIL_FROM=NotaryChain <noreply@notarychain.com>

# ------------------------------------------------------------------------------
# 9. Frontend Client Environment Variables (Vite)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id_here
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
VITE_FREIGHTER_TESTNET_WALLET=your_freighter_testnet_wallet_address_here
